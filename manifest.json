{
  "manifest_version": 3,
  "name": "Decathlon SMAX Magic Wand",
  "version": "1.0",
  "permissions": ["identity", "storage", "activeTab"],
  "host_permissions": [
    "https://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://support.decathlon.net/saw/Request*"],
      "js": ["content.js"],
      "css": ["style.css"] 
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["baguetteMagique.png"],
      "matches": ["https://support.decathlon.net/*"]
    }
  ]
  
}